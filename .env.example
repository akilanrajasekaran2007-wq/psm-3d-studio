# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MESHY_API_KEY: Optional official Meshy API Key (from https://www.meshy.ai/)
# Enables direct generation through Meshy's Text-to-3D and Image-to-3D endpoints.
MESHY_API_KEY=""

# LOCAL_3D_SERVER_URL: Optional local or self-hosted Python 3D model inference server (e.g., TripoSR / Trellis).
# Default: http://localhost:8000
LOCAL_3D_SERVER_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

